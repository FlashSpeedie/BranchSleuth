# BranchSleuth environment configuration
# Copy to .env and fill in real values. NEVER commit .env.

# PostgreSQL (Neon) connection string used by the backend and worker
DATABASE_URL=

# Optional: require this API key on all API requests (Authorization: Bearer <key> or X-API-Key).
# Leave empty ONLY for trusted localhost development. Production deployments must set it.
BS_API_KEY=

# Comma-separated allowlist of HTTPS git hosts repos may be cloned from
BS_ALLOWED_GIT_HOSTS=github.com,gitlab.com,bitbucket.org

# Local directory where repositories, snapshots and artifacts are stored
BS_DATA_DIR=./data

# Allow registering repositories from local filesystem paths (self-hosted dev mode only)
BS_ALLOW_LOCAL_REPOS=true

# Max ZIP upload size in bytes (default 50MB)
BS_MAX_UPLOAD_BYTES=52428800

# Max extracted repo size in bytes (default 200MB) and max file count
BS_MAX_EXTRACTED_BYTES=209715200
BS_MAX_REPO_FILES=20000

# Resource limits for verification containers
BS_CONTAINER_MEM_BYTES=2147483648
BS_CONTAINER_CPUS=2
BS_DEPS_TIMEOUT_SECONDS=300
BS_TESTS_TIMEOUT_SECONDS=600
BS_PROBE_TIMEOUT_SECONDS=240

# Hypothesis budget for targeted verification
BS_HYPOTHESIS_MAX_EXAMPLES=60
BS_HYPOTHESIS_DEADLINE_MS=2000

# Comma-separated CORS origins for the frontend
BS_CORS_ORIGINS=http://localhost:3000

# Optional LLM assistance (AI gateway base URL + key). The core product works without it.
BS_AI_GATEWAY_URL=
BS_AI_GATEWAY_KEY=
